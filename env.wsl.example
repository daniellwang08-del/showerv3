# ============================================================
# WSL2 laptop profile (16 GB RAM, RTX 4050 6 GB, Ubuntu 24.04)
# ============================================================
#   cp env.wsl.example .env.wsl      # .env.wsl is gitignored; put real secrets there
#   scripts/wsl-stack.sh up
#
# scripts/wsl-stack.sh exports this file into every supervised process, so these
# values win over .env / .env.local (real process env beats dotenv files).
# The file is sourced by bash: quote any value containing spaces or $.
# Full variable reference: env.example. Compose overlay: docker-compose.laptop.yml.
# ============================================================

APP_ENV=local
# Supervisor restarts programs; file watchers would double-restart them.
RELOAD=0
WORKER_RELOAD=0
DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL (docker-compose.laptop.yml: max_connections=80).
# ~10 processes x (4 + 4) connections stays under that ceiling.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_scraper
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_scraper
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=6
# API processes (Linux, RELOAD=0 only). The API is I/O bound here, so one process
# measured faster than three (per-process caches stay warm). If raised, keep
# API_WORKERS x (pool + overflow) plus every worker pool under max_connections (150).
API_WORKERS=1

# Redis (docker-compose.laptop.yml: maxmemory 512mb, noeviction)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
REDIS_PUBSUB_URL=redis://localhost:6379/2
REDIS_POOL_SIZE=10
REDIS_BROKER_POOL_SIZE=10
REDIS_PUBSUB_POOL_SIZE=5
ARQ_KEEP_RESULT_SECONDS=0

# Auth - generate your own: openssl rand -hex 32
AUTH_SECRET_KEY=change-me-openssl-rand-hex-32
SETTINGS_ENCRYPTION_KEY=

# Cloud LLM for tailoring (speed is provider rate limit, not the GPU)
OPENAI_API_KEY=your-openai-compatible-api-key-here
# OPENAI_API_BASE=https://llm.example.com/v1
OPENAI_MODEL=gpt-5.1
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=240

# Worker concurrency (arq max_jobs per process; Admin -> System Settings overrides)
EXTRACTION_WORKER_MAX_JOBS=24
SCRAPER_WORKER_MAX_JOBS=4
ENCODING_WORKER_MAX_JOBS=16
ANALYSIS_WORKER_MAX_JOBS=12
SAVE_WORKER_MAX_JOBS=8
TAILORING_WORKER_MAX_JOBS=6
RESUME_WORKER_MAX_JOBS=3
AUTOPOST_WORKER_MAX_JOBS=4

# Browser (Playwright) pool. Caps Chromium pages independently of EXTRACTION_WORKER_MAX_JOBS.
# Only the extraction worker owns Chromium; the API skips its warm-up pool.
BROWSER_POOL_SIZE=6
BROWSER_POOL_WARMUP=false
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
# Phase 3: true drops --disable-gpu; only with >2 GB VRAM headroom in nvidia-smi.
BROWSER_USE_GPU=false
RATE_LIMIT_REQUESTS_PER_SECOND=4.0
RATE_LIMIT_BURST=6

# Embeddings: only the encoding worker loads torch (CUDA MiniLM).
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=128
EMBEDDING_INLINE=false

# Vite runs in WSL; Chrome on Windows opens http://127.0.0.1:5173 via
# localhost forwarding. Pin HMR to loopback (auto-detect picks the WSL eth0 IP).
VITE_HMR_HOST=127.0.0.1
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Paths
GOOGLE_SHEETS_CREDENTIALS_PATH=google_credentials.json
RESUME_OUTPUT_ROOT=./resume_output
USER_TEMPLATES_ROOT=./user_templates

# Scraper (fill as needed; see env.example)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
SCRAPER_PROXY_URL=
HTTP_MAX_CONCURRENCY=24
SCRAPER_PARALLEL_SPIDERS=3
