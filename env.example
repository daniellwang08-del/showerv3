# ============================================================
# Environment Configuration
# ============================================================
# Copy this file to create your environment configs:
#   .env            - base defaults (always loaded first)
#   .env.local      - local development overrides
#   .env.production - production / Neon DB overrides
#
# Set APP_ENV to control which overlay is loaded:
#   APP_ENV=local        -> loads .env then .env.local
#   APP_ENV=production   -> loads .env then .env.production
#
# On Render.com, env vars are injected directly (no files needed).
# ============================================================

APP_ENV=local

# Auto-reload API + workers when app/ Python files change (local dev).
# Default: on for APP_ENV=local, off for production. Set RELOAD=0 to disable.
# RELOAD=1

APP_NAME=Job Description Scraper
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL (local install on :5432, or Docker: docker compose --profile docker-db up -d postgres)
# POSTGRES_* must match DATABASE_URL (compose interpolates these from .env).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_scraper
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_scraper
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis — broker (arq queues). Local Docker: docker compose up -d redis
# Logical DB split is optional; managed Redis (Render KV) often only allows /0 —
# leave CACHE/PUBSUB unset there so they reuse REDIS_URL.
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
REDIS_PUBSUB_URL=redis://localhost:6379/2
REDIS_POOL_SIZE=10
REDIS_BROKER_POOL_SIZE=10
REDIS_PUBSUB_POOL_SIZE=5
# Production fail-loud (no in-process BackgroundTasks). Auto-on when APP_ENV=production.
# REDIS_REQUIRE_FOR_JOBS=true
# arq result TTL seconds (0 = do not keep; frees job ids for re-runs)
ARQ_KEEP_RESULT_SECONDS=0
# Transient-stage retries (save/tailor/resume/scraper stay at max_tries=1)
EXTRACTION_WORKER_MAX_TRIES=3
ANALYSIS_WORKER_MAX_TRIES=3
TAILORING_WORKER_MAX_TRIES=3

# OpenAI-compatible LLM gateway (native OpenAI or proxy such as LiteLLM / private gateway).
# One key can unlock many models — discover them via GET {OPENAI_API_BASE}/models and
# bind per job in Admin → System Settings → Job → key bindings.
OPENAI_API_KEY=your-openai-compatible-api-key-here
# Optional: custom base URL. Empty = api.openai.com. Accepts with or without trailing /v1.
# OPENAI_API_BASE=https://llm.example.com/v1
# Default model when a job binding does not select one.
OPENAI_MODEL=gpt-5.1
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.1
# low | medium | high — GPT-5 / o-series reasoning depth (ignored for gpt-4.x)
OPENAI_REASONING_EFFORT=high
OPENAI_TIMEOUT_SECONDS=240

# Worker concurrency (arq max_jobs per process). Overridable in Admin → System Settings.
# ANALYSIS_WORKER_MAX_JOBS=6
# TAILORING_WORKER_MAX_JOBS=8
# EXTRACTION_WORKER_MAX_JOBS=10
# SAVE_WORKER_MAX_JOBS=10
# AUTOPOST_WORKER_MAX_JOBS=4
# RESUME_WORKER_MAX_JOBS=10
# SCRAPER_WORKER_MAX_JOBS=2

# Langfuse (OpenAI observability - token usage, cost, latency)
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# Browser (Playwright) — keep pool size aligned with EXTRACTION_WORKER_MAX_JOBS
BROWSER_POOL_SIZE=10
BROWSER_TIMEOUT_MS=30000
BROWSER_HEADLESS=true

# HTTP Client
HTTP_TIMEOUT_SECONDS=30.0
HTTP_MAX_RETRIES=3
HTTP_RETRY_DELAY_SECONDS=1.0

# Rate Limiting — align with extraction concurrency
RATE_LIMIT_REQUESTS_PER_SECOND=10.0
RATE_LIMIT_BURST=10

# Caching
EXTRACTION_CACHE_TTL_SECONDS=86400

# Deduplication
# Per-user recycle window (dedup_recycle_days) is stored in the users table (default 60)
# and editable in the app under Profiles → Deduplication settings - not an env var.
# DEDUP_WINDOW_HOURS is legacy/unused; kept for backward compatibility only.
DEDUP_WINDOW_HOURS=24

# Proxy (HTTP client)
PROXY_ENABLED=false
PROXY_URL=

# Auth - JWT signing secret (required). User passwords are stored in PostgreSQL.
AUTH_SECRET_KEY=your-secret-key-here

# Production CORS: add your deployed frontend origin (local dev origins are built-in)
# FRONTEND_URL=https://your-frontend.onrender.com

# Optional: extra CORS origins (comma-separated), e.g. http://172.20.1.140:5173
# CORS_EXTRA_ORIGINS=

# Optional: pin LAN IP for Vite HMR when auto-detection picks the wrong interface
# LAN_HOST=172.20.1.140
# VITE_HMR_HOST=172.20.1.140

# Optional: backend URL for Vite dev proxy (default http://127.0.0.1:8000)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# API bind address. Local dev defaults to 127.0.0.1 (LAN users use Vite on :5173).
# Set API_HOST=0.0.0.0 only if you need direct http://<lan-ip>:8000 access.
# API_HOST=127.0.0.1

# Google Sheets (service account credentials JSON path)
GOOGLE_SHEETS_CREDENTIALS_PATH=google_credentials.json

# Resume builder (PDF via pure-Python dxpdf package — no LibreOffice needed)
RESUME_OUTPUT_ROOT=./resume_output
RESUME_TEMPLATE_PATH=app/templates/resume_template.docx
COVER_LETTER_TEMPLATE_PATH=app/templates/cover_letter_template.docx
USER_TEMPLATES_ROOT=./user_templates
RESUME_TEMPLATE_MAX_BYTES=5000000

# Scraper module (Adzuna publisher API + optional proxy list)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
SCRAPER_PROXY_LIST_PATH=
