{
  "manifest_version": 3,
  "name": "NAO",
  "version": "2.1.0",
  "description": "Apply faster with NAO: tailored resumes, application autofill, and an assistant that knows each job.",
  "key": "",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "webNavigation",
    "cookies"
  ],
  "optional_host_permissions": ["*://*/*", "https://*.greenhouse.io/*"],
  "host_permissions": [
    "https://nao.it.com/*",
    "https://www.nao.it.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://localhost/*",
    "https://*.jobright.ai/*",
    "https://jobright.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nao.it.com/*",
        "https://www.nao.it.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*"
      ],
      "js": ["content/webapp-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Open NAO Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["installed.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
