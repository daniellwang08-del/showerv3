{
  "manifest_version": 3,
  "name": "Job Application Assistant",
  "version": "1.0.0",
  "description": "Job-specific AI assistant that uses your Atomspace profile and job descriptions to help fill out applications.",
  "key": "",
  "permissions": ["storage", "sidePanel", "tabs", "scripting", "webNavigation"],
  "optional_host_permissions": ["*://*/*", "https://*.greenhouse.io/*"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*"
      ],
      "js": ["content/webapp-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Open Job Application Assistant"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["installed.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
